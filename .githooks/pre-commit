#!/usr/bin/env python
"""Pre-commit hook: Windows path safety + cross-reference data validation.

Setup (one-time per clone):
    git config core.hooksPath .githooks
"""
import os, re, subprocess, sys


_resolved_python_cache = None


def resolve_python():
    """Pick a Python that has our deps (jsonschema) installed.

    VS Code / GitHub Desktop / some Windows git UIs invoke the hook via a
    Python that lacks project deps. Prefer (in order): the interpreter
    currently running this hook (if jsonschema is importable), UE's
    bundled Python, then a `python`/`python3`/`py` on PATH. Failing all
    that, return sys.executable and let the subprocess report the error.

    Memoized at module scope - probing up to 5 candidates per call and
    spawning a subprocess each time is wasted work when the hook fires
    two validators back-to-back.
    """
    global _resolved_python_cache
    if _resolved_python_cache is not None:
        return _resolved_python_cache

    def has_jsonschema(exe):
        try:
            r = subprocess.run(
                [exe, "-c", "import jsonschema"],
                capture_output=True, text=True, timeout=10,
            )
            return r.returncode == 0
        except Exception:
            return False

    candidates = [sys.executable]
    # UE bundled Python (Windows) — scripts/config/ue_path.conf is the SOT,
    # but a hook can't read that without re-implementing shell parsing; try
    # the common install roots instead.
    for ue_root in (
        os.environ.get("UE_PATH"),
        r"C:\UnrealEngine\UE_5.7",
        r"C:\Program Files\Epic Games\UE_5.7",
    ):
        if ue_root:
            ue_py = os.path.join(
                ue_root, "Engine", "Binaries", "ThirdParty",
                "Python3", "Win64", "python.exe",
            )
            if os.path.exists(ue_py):
                candidates.append(ue_py)
    # Fall back to PATH.
    for name in ("python", "python3", "py"):
        candidates.append(name)

    for c in candidates:
        if has_jsonschema(c):
            _resolved_python_cache = c
            return c
    _resolved_python_cache = sys.executable  # let the failure surface
    return _resolved_python_cache

# ---------------------------------------------------------------------------
# 1. Windows reserved-name and path checks
# ---------------------------------------------------------------------------
staged = subprocess.check_output(
    ["git", "diff", "--cached", "--name-only"], text=True
).splitlines()

bad = []
absolute = []
backslash = []
for p in staged:
    b = os.path.basename(p).lower().rstrip(" .")
    if re.fullmatch(r"(con|prn|aux|nul|com[1-9]|lpt[1-9])(\..*)?", b):
        bad.append(p)
    if re.match(r"^[A-Za-z]:[/\\]|^/mnt/[a-z]/|^/", p):
        absolute.append(p)
    if "\\" in p:
        backslash.append(p)

errors = []
if bad:
    errors.append(
        "Blocked reserved Windows filenames:\n"
        + "\n".join("  - " + x for x in bad)
    )
if absolute:
    errors.append(
        "Blocked absolute paths:\n"
        + "\n".join("  - " + x for x in absolute)
    )
if backslash:
    errors.append(
        "Blocked paths with backslashes:\n"
        + "\n".join("  - " + x for x in backslash)
    )

# ---------------------------------------------------------------------------
# 2. Cross-reference validation (only when relevant files changed)
# ---------------------------------------------------------------------------
MIND_DATA_TRIGGERS = {
    "Plugins/Gameplay/ProjectMind/Data/dialogue_thought_mappings.json",
}
DLG_PATTERN = re.compile(r"DLG_.*\.json$")

needs_mind_check = any(
    p in MIND_DATA_TRIGGERS or DLG_PATTERN.search(p)
    for p in staged
)

if needs_mind_check:
    repo_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    validator = os.path.join(
        repo_root,
        "scripts", "ue", "check", "gameplay", "projectmind", "validate_data.py",
    )
    if os.path.exists(validator):
        result = subprocess.run(
            [resolve_python(), validator],
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            errors.append(
                "ProjectMind data cross-reference check failed:\n"
                + result.stdout.strip()
            )

# ---------------------------------------------------------------------------
# 3. Object/dialogue/audio data cross-reference validation
# ---------------------------------------------------------------------------
OBJECT_DATA_PATTERN = re.compile(
    r"Plugins/Resources/ProjectObject/(Content|Data)/.*\.json$"
)
# Any data JSON (or schema file) staged triggers the inline $schema check.
PLUGIN_DATA_JSON_PATTERN = re.compile(r"^Plugins/[^/]+/[^/]+/Data/.+\.json$")

needs_object_ref_check = any(
    OBJECT_DATA_PATTERN.search(p) or PLUGIN_DATA_JSON_PATTERN.search(p)
    for p in staged
)

if needs_object_ref_check:
    repo_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    data_validator = os.path.join(
        repo_root,
        "scripts", "ue", "check", "data", "validate_all.py",
    )
    if os.path.exists(data_validator):
        py = resolve_python()
        result = subprocess.run(
            [py, data_validator],
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            detail = (result.stdout.strip() + "\n" + result.stderr.strip()).strip()
            if not detail:
                detail = f"(validator exited {result.returncode} with no output; python={py})"
            errors.append(
                f"Data cross-reference check failed (python={py}, rc={result.returncode}):\n"
                + detail
            )

# ---------------------------------------------------------------------------
# Result
# ---------------------------------------------------------------------------
if errors:
    print("\n\n".join(errors))
    sys.exit(1)
