#!/usr/bin/env python
"""Pre-commit hook: Windows path safety + cross-reference data validation.

Setup (one-time per clone):
    git config core.hooksPath .githooks
"""
import os, re, subprocess, sys

# ---------------------------------------------------------------------------
# 1. Windows reserved-name and path checks
# ---------------------------------------------------------------------------
staged = subprocess.check_output(
    ["git", "diff", "--cached", "--name-only"], text=True
).splitlines()

bad = []
absolute = []
backslash = []
for p in staged:
    b = os.path.basename(p).lower().rstrip(" .")
    if re.fullmatch(r"(con|prn|aux|nul|com[1-9]|lpt[1-9])(\..*)?", b):
        bad.append(p)
    if re.match(r"^[A-Za-z]:[/\\]|^/mnt/[a-z]/|^/", p):
        absolute.append(p)
    if "\\" in p:
        backslash.append(p)

errors = []
if bad:
    errors.append(
        "Blocked reserved Windows filenames:\n"
        + "\n".join("  - " + x for x in bad)
    )
if absolute:
    errors.append(
        "Blocked absolute paths:\n"
        + "\n".join("  - " + x for x in absolute)
    )
if backslash:
    errors.append(
        "Blocked paths with backslashes:\n"
        + "\n".join("  - " + x for x in backslash)
    )

# ---------------------------------------------------------------------------
# 2. Cross-reference validation (only when relevant files changed)
# ---------------------------------------------------------------------------
MIND_DATA_TRIGGERS = {
    "Plugins/Gameplay/ProjectMind/Data/dialogue_thought_mappings.json",
}
DLG_PATTERN = re.compile(r"DLG_.*\.json$")

needs_mind_check = any(
    p in MIND_DATA_TRIGGERS or DLG_PATTERN.search(p)
    for p in staged
)

if needs_mind_check:
    repo_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    validator = os.path.join(
        repo_root,
        "scripts", "ue", "check", "gameplay", "projectmind", "validate_data.py",
    )
    if os.path.exists(validator):
        result = subprocess.run(
            [sys.executable, validator],
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            errors.append(
                "ProjectMind data cross-reference check failed:\n"
                + result.stdout.strip()
            )

# ---------------------------------------------------------------------------
# 3. Object/dialogue/audio data cross-reference validation
# ---------------------------------------------------------------------------
OBJECT_DATA_PATTERN = re.compile(
    r"Plugins/Resources/ProjectObject/(Content|Data)/.*\.json$"
)

needs_object_ref_check = any(
    OBJECT_DATA_PATTERN.search(p) for p in staged
)

if needs_object_ref_check:
    repo_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    data_validator = os.path.join(
        repo_root,
        "scripts", "ue", "check", "data", "validate_all.py",
    )
    if os.path.exists(data_validator):
        result = subprocess.run(
            [sys.executable, data_validator],
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            errors.append(
                "Data cross-reference check failed:\n"
                + result.stdout.strip()
            )

# ---------------------------------------------------------------------------
# Result
# ---------------------------------------------------------------------------
if errors:
    print("\n\n".join(errors))
    sys.exit(1)
