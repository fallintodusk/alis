{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alis.world/schemas/world-compiler/constructed-import-model-v1.json",
  "type": "object",
  "required": ["$schema", "schema_version", "basis", "canonical_crs", "vertical_datum", "provenance", "models"],
  "properties": {
    "$schema": {"const": "https://alis.world/schemas/world-compiler/constructed-import-model-v1.json"},
    "schema_version": {"const": 1},
    "basis": {"const": "declared_identified_static_pwa"},
    "canonical_crs": {"type": "string", "pattern": "^EPSG:[0-9]+$"},
    "vertical_datum": {"const": "EPSG:3855"},
    "provenance": {"type": "object", "required": ["basis", "producer_sha256"],
      "properties": {"basis": {"type": "string", "minLength": 1},
        "producer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "models": {"type": "array", "minItems": 1, "maxItems": 16, "items": {
      "type": "object", "required": ["primary_source_id", "role", "source_bindings", "footprint", "triangles", "face_roles"],
      "properties": {
        "primary_source_id": {"type": "string", "pattern": "^(way|relation)/[1-9][0-9]*$"},
        "role": {"$ref": "https://alis.world/schemas/world-compiler/constructed-surface-v1.json#/$defs/model_role"},
        "source_bindings": {"type": "array", "minItems": 1, "maxItems": 32, "items": {
          "type": "object", "required": ["context_id", "provider_feature_id"],
          "properties": {"context_id": {"type": "string", "minLength": 1},
            "provider_feature_id": {"type": "string", "pattern": "^(way|relation)/[1-9][0-9]*$"}}, "additionalProperties": false
        }},
        "footprint": {"oneOf": [
          {"type": "object", "required": ["type", "coordinates"], "properties": {
            "type": {"const": "Polygon"}, "coordinates": {"$ref": "#/$defs/polygon"}}, "additionalProperties": false},
          {"type": "object", "required": ["type", "coordinates"], "properties": {
            "type": {"const": "MultiPolygon"}, "coordinates": {"type": "array", "minItems": 1, "maxItems": 256,
              "items": {"$ref": "#/$defs/polygon"}}}, "additionalProperties": false}
        ]},
        "triangles": {"$ref": "https://alis.world/schemas/world-compiler/constructed-surface-v1.json#/$defs/triangles"},
        "face_roles": {"$ref": "https://alis.world/schemas/world-compiler/constructed-surface-v1.json#/$defs/face_roles"}
      }, "additionalProperties": false
    }}
  }, "additionalProperties": false,
  "$defs": {
    "point": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "ring": {"type": "array", "minItems": 4, "maxItems": 65536, "items": {"$ref": "#/$defs/point"}},
    "polygon": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/ring"}}
  }
}
