{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alis.world/schemas/world-compiler/constructed-surface-v1.json",
  "title": "Source-bound identified structural surface",
  "type": "object",
  "required": ["schema_version", "source_feature_id", "model_sha256", "canonical_crs", "vertical_datum", "basis", "role", "triangles", "face_roles", "source_bindings", "policy_sha256", "model_provenance"],
  "properties": {
    "schema_version": {"const": 1},
    "source_feature_id": {"type": "string", "minLength": 1},
    "model_sha256": {"$ref": "#/$defs/hash"},
    "canonical_crs": {"type": "string", "pattern": "^EPSG:[0-9]+$"},
    "vertical_datum": {"const": "EPSG:3855"},
    "basis": {"const": "identified_model"},
    "role": {"$ref": "#/$defs/model_role"},
    "triangles": {"$ref": "#/$defs/triangles"},
    "face_roles": {"$ref": "#/$defs/face_roles"},
    "source_bindings": {"type": "array", "minItems": 1, "maxItems": 32, "items": {
      "type": "object", "required": ["context_id", "provider_feature_id", "qualification_identity", "qualified", "projected_geometry", "normalized_input", "native_input"],
      "properties": {
        "context_id": {"type": "string", "minLength": 1},
        "provider_feature_id": {"type": "string", "pattern": "^(way|relation)/[1-9][0-9]*$"},
        "qualification_identity": {"$ref": "#/$defs/hash"},
        "qualified": {"type": "object"},
        "projected_geometry": {"type": "object"},
        "normalized_input": {"$ref": "#/$defs/descriptor"},
        "native_input": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/descriptor"}]}
      }, "additionalProperties": false
    }},
    "policy_sha256": {"$ref": "#/$defs/hash"},
    "model_provenance": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "descriptor": {
      "type": "object", "required": ["path", "sha256", "byte_size"],
      "properties": {
        "path": {"type": "string", "pattern": "^refinement/inputs/[0-9a-f]{64}\\.json$"},
        "sha256": {"$ref": "#/$defs/hash"}, "byte_size": {"type": "integer", "minimum": 1}
      }, "additionalProperties": false
    },
    "model_role": {"enum": ["fixed_pier", "floating_assembly", "identified_assembly", "inferred_apron", "inferred_gate_apron"]},
    "face_role": {"enum": ["fixed_pier", "floating_deck", "gangway", "inferred_apron", "inferred_gate_apron"]},
    "point": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "triangles": {"type": "array", "minItems": 1, "maxItems": 4096,
      "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/point"}}},
    "face_roles": {"type": "array", "minItems": 1, "maxItems": 64, "items": {
      "type": "object", "required": ["role", "source_ids", "triangles"],
      "properties": {
        "role": {"$ref": "#/$defs/face_role"},
        "source_ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(way|relation)/[1-9][0-9]*$"}},
        "triangles": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}},
        "axis_source_id": {"type": "string", "pattern": "^way/[1-9][0-9]*$"}
      }, "additionalProperties": false,
      "allOf": [{"if": {"properties": {"role": {"const": "gangway"}}},
        "then": {"required": ["axis_source_id"]}, "else": {"not": {"required": ["axis_source_id"]}}}]
    }}
  }
}
