{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alis.world/schemas/world-compiler/compile-result-v1.json",
  "title": "World Compiler Result",
  "type": "object",
  "required": ["$schema", "schema_version", "operation_id", "operation", "status", "profile_id", "inputs_hash", "path_base", "outputs", "errors"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "operation_id": {"type": "string"},
    "operation": {"enum": ["plan", "compile", "validate"]},
    "status": {"enum": ["accepted", "rejected", "failed"]},
    "profile_id": {"type": ["string", "null"]},
    "inputs_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "path_base": {"const": "output_root"},
    "outputs": {"type": "array", "items": {"type": "object", "required": ["kind", "path", "sha256", "byte_size"], "properties": {"kind": {"type": "string"}, "path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "byte_size": {"type": "integer", "minimum": 1}}, "additionalProperties": false}},
    "errors": {"type": "array", "items": {"type": "object", "required": ["code", "message", "details"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "details": {"type": "object"}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
