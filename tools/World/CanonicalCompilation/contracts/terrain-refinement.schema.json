{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alis.world/schemas/world-compiler/terrain-refinement-v1.json",
  "title": "Canonical final terrain refinement",
  "type": "object",
  "required": ["$schema", "schema_version", "grid_id", "cell_id", "base", "coordinate_rule", "consumed", "policy", "quads", "metrics"],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "limit": {"type": "number", "minimum": 0},
    "index": {"type": "integer", "minimum": 0}
  },
  "properties": {
    "$schema": {"const": "https://alis.world/schemas/world-compiler/terrain-refinement-v1.json"},
    "schema_version": {"const": 1},
    "grid_id": {"type": "string", "minLength": 1},
    "cell_id": {"type": "string", "minLength": 1},
    "base": {
      "type": "object", "required": ["path", "sha256", "byte_size"],
      "properties": {
        "path": {"type": "string", "pattern": "^canonical/terrain/[^/]+\\.json$"},
        "sha256": {"$ref": "#/$defs/hash"},
        "byte_size": {"type": "integer", "minimum": 1}
      }, "additionalProperties": false
    },
    "coordinate_rule": {"const": "canonical_boundary_intersections_float64"},
    "consumed": {
      "type": "object",
      "required": ["water_feature_id", "water_sha256", "policy_sha256", "implementation_sha256", "execution_identity", "domain_sha256"],
      "properties": {
        "water_feature_id": {"type": "string", "minLength": 1},
        "water_sha256": {"$ref": "#/$defs/hash"},
        "policy_sha256": {"$ref": "#/$defs/hash"},
        "implementation_sha256": {"$ref": "#/$defs/hash"},
        "execution_identity": {"$ref": "#/$defs/hash"},
        "domain_sha256": {"$ref": "#/$defs/hash"}
      }, "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["accepted_accuracy", "maximum_cut_m", "maximum_fill_m", "maximum_dry_distance_m", "maximum_bank_gradient", "maximum_triangles", "water_clearance_m"],
      "properties": {
        "accepted_accuracy": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "maximum_cut_m": {"$ref": "#/$defs/limit"},
        "maximum_fill_m": {"$ref": "#/$defs/limit"},
        "maximum_dry_distance_m": {"$ref": "#/$defs/limit"},
        "maximum_bank_gradient": {"$ref": "#/$defs/limit"},
        "maximum_triangles": {"type": "integer", "minimum": 2, "maximum": 4096},
        "water_clearance_m": {"$ref": "#/$defs/limit"}
      }, "additionalProperties": false
    },
    "quads": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["coordinate", "vertices", "triangles", "water_triangles"],
        "properties": {
          "coordinate": {"type": "array", "items": {"$ref": "#/$defs/index"}, "minItems": 2, "maxItems": 2},
          "vertices": {"type": "array", "minItems": 3, "items": {"type": "array", "items": {"type": "number"}, "minItems": 5, "maxItems": 5}},
          "triangles": {"type": "array", "minItems": 2, "maxItems": 4096, "items": {"type": "array", "items": {"$ref": "#/$defs/index"}, "minItems": 3, "maxItems": 3, "uniqueItems": true}},
          "water_triangles": {"type": "array", "items": {"$ref": "#/$defs/index"}, "uniqueItems": true}
        }, "additionalProperties": false
      }
    },
    "metrics": {
      "type": "object",
      "required": ["maximum_cut_m", "maximum_fill_m", "cut_volume_m3", "maximum_dry_distance_bound_m", "maximum_bank_gradient"],
      "properties": {
        "maximum_cut_m": {"$ref": "#/$defs/limit"}, "maximum_fill_m": {"$ref": "#/$defs/limit"},
        "cut_volume_m3": {"$ref": "#/$defs/limit"}, "maximum_dry_distance_bound_m": {"$ref": "#/$defs/limit"},
        "maximum_bank_gradient": {"$ref": "#/$defs/limit"}
      }, "additionalProperties": false
    }
  },
  "additionalProperties": false
}
