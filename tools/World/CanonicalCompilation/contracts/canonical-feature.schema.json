{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alis.world/schemas/world-compiler/canonical-feature-v1.json",
  "title": "Canonical Feature Shard",
  "type": "object",
  "required": ["$schema", "schema_version", "grid_id", "cell_id", "features"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "grid_id": {"type": "string", "pattern": "^grid_[0-9a-f]{16}$"},
    "cell_id": {"type": "string", "minLength": 1},
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["feature_id", "feature_class", "geometry", "attributes", "source_refs", "owner_cell_id", "intersecting_cell_ids", "representations", "provenance_result"],
        "properties": {
          "feature_id": {"type": "string", "pattern": "^alis:[a-z0-9_]+:[a-z]+:[0-9]+$"},
          "feature_class": {"enum": ["road", "building", "water", "land_cover", "vegetation_area", "foliage_point"]},
          "geometry": {"type": "object"},
          "attributes": {
            "type": "object",
            "properties": {
              "building_massing_version": {"const": 2},
              "logical_building_id": {"type": "string", "pattern": "^(node|way|relation)/[0-9]+$"},
              "volume_selection": {"enum": ["outline_no_parts", "complete_parts", "outline_fallback_incomplete_parts"]},
              "effective_volumes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["volume_id", "geometry", "min_height_m", "height_m", "height_basis", "min_height_basis", "source_feature_id"],
                  "properties": {
                    "volume_id": {"type": "string", "minLength": 1},
                    "geometry": {"type": "object"},
                    "min_height_m": {"type": "number", "minimum": 0},
                    "height_m": {"type": "number", "exclusiveMinimum": 0},
                    "height_basis": {"type": "string", "minLength": 1},
                    "min_height_basis": {"type": "string", "minLength": 1},
                    "source_feature_id": {"type": "string", "pattern": "^(node|way|relation)/[0-9]+$"}
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "source_refs": {"type": "array", "minItems": 1},
          "owner_cell_id": {"type": "string"},
          "intersecting_cell_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "representations": {"type": "array"},
          "provenance_result": {"const": "accepted"},
          "authored_overlay_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
