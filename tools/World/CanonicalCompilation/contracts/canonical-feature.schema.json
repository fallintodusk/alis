{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alis.world/schemas/world-compiler/canonical-feature-v1.json",
  "title": "Canonical Feature Shard",
  "type": "object",
  "required": ["$schema", "schema_version", "grid_id", "cell_id", "features"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "grid_id": {"type": "string", "pattern": "^grid_[0-9a-f]{16}$"},
    "cell_id": {"type": "string", "minLength": 1},
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["feature_id", "feature_class", "geometry", "attributes", "source_refs", "owner_cell_id", "intersecting_cell_ids", "representations", "provenance_result"],
        "properties": {
          "feature_id": {"type": "string", "pattern": "^alis:[a-z0-9_]+:[a-z]+:[0-9]+$"},
          "feature_class": {"enum": ["road", "building", "water", "land_cover", "vegetation_area", "foliage_point", "constructed_surface"]},
          "geometry": {"type": "object"},
          "attributes": {
            "type": "object",
            "properties": {
              "surface_function": {"type": "object", "allOf": [{
                "if": {"required": ["function_id"], "properties": {"function_id": {"const": "identified_static_lined_basin"}}},
                "then": {"$ref": "https://alis.world/schemas/world-compiler/identified-basin-surface-v1.json"}
              }]},
              "constructed_surface": {"$ref": "https://alis.world/schemas/world-compiler/constructed-surface-v1.json"},
              "surface_context": {
                "type": "object",
                "required": ["version", "ground_relation", "bridge", "tunnel", "ford", "covered", "relative_layer", "water_origin", "water_kind", "source_tags", "source_nodes", "unresolved"],
                "properties": {
                  "version": {"const": 1},
                  "ground_relation": {"enum": ["above", "below", "at_ground", "unknown", "conflicting"]},
                  "bridge": {"enum": ["present", "absent", "unknown"]},
                  "tunnel": {"enum": ["present", "absent", "unknown"]},
                  "ford": {"enum": ["present", "absent", "unknown"]},
                  "covered": {"enum": ["present", "absent", "unknown"]},
                  "relative_layer": {"type": ["integer", "null"], "minimum": -2147483648, "maximum": 2147483647},
                  "water_origin": {"enum": ["constructed", "unknown"]},
                  "water_kind": {"enum": ["fountain", "pool", "basin", "reservoir", "unspecified"]},
                  "source_tags": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
                  "source_nodes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["provider_node_id", "xy"],
                      "properties": {
                        "provider_node_id": {"type": "string", "pattern": "^node/[1-9][0-9]*$"},
                        "xy": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
                      },
                      "additionalProperties": false
                    }
                  },
                  "unresolved": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
                },
                "additionalProperties": false
              },
              "building_massing_version": {"const": 2},
              "logical_building_id": {"type": "string", "pattern": "^(node|way|relation)/[0-9]+$"},
              "volume_selection": {"enum": ["outline_no_parts", "complete_parts", "outline_fallback_incomplete_parts"]},
              "effective_volumes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["volume_id", "geometry", "min_height_m", "height_m", "height_basis", "min_height_basis", "source_feature_id"],
                  "properties": {
                    "volume_id": {"type": "string", "minLength": 1},
                    "geometry": {"type": "object"},
                    "min_height_m": {"type": "number", "minimum": 0},
                    "height_m": {"type": "number", "exclusiveMinimum": 0},
                    "height_basis": {"type": "string", "minLength": 1},
                    "min_height_basis": {"type": "string", "minLength": 1},
                    "source_feature_id": {"type": "string", "pattern": "^(node|way|relation)/[0-9]+$"}
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "source_refs": {"type": "array", "minItems": 1},
          "owner_cell_id": {"type": "string"},
          "intersecting_cell_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "representations": {"type": "array"},
          "provenance_result": {"const": "accepted"},
          "authored_overlay_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false,
        "allOf": [{
          "if": {"properties": {"feature_class": {"const": "constructed_surface"}}},
          "then": {"properties": {"attributes": {"required": ["constructed_surface"]}}},
          "else": {"properties": {"attributes": {"not": {"required": ["constructed_surface"]}}}}
        }]
      }
    }
  },
  "additionalProperties": false
}
