{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ALIS Developer Asset Release Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "contract_id", "world_authorities", "asset_authorities"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 2 },
    "contract_id": { "type": "string", "minLength": 1 },
    "world_authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "canonical_profiles"],
        "properties": {
          "owner": { "type": "string", "minLength": 1 },
          "canonical_profiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
          }
        }
      }
    },
    "asset_authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "authority_kind", "owner", "manifest_path", "license_id",
          "distribution_class", "dependency_payload_policy"
        ],
        "properties": {
          "authority_kind": {
            "enum": ["generated_definition_manifest", "generated_recipe_manifest", "producer_input"]
          },
          "owner": { "type": "string", "minLength": 1 },
          "manifest_path": { "type": "string", "minLength": 1 },
          "manifest_schema_ref": { "type": "string", "minLength": 1 },
          "manifest_id": { "type": "string", "minLength": 1 },
          "license_id": { "enum": ["MPL-2.0", "CC-BY-4.0", "CC0-1.0"] },
          "distribution_class": { "type": "string", "minLength": 1 },
          "dependency_payload_policy": { "const": "references_only" },
          "collections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["asset_class", "schema_path", "source_root", "package_root", "artifact_root"],
              "properties": {
                "asset_class": { "type": "string", "minLength": 1 },
                "schema_path": { "type": "string", "minLength": 1 },
                "source_root": { "type": "string", "minLength": 1 },
                "package_root": { "type": "string", "pattern": "^/" },
                "artifact_root": { "type": "string", "minLength": 1 }
              }
            }
          },
          "recipe_root": { "type": "string", "minLength": 1 },
          "recipe_suffix": { "type": "string", "pattern": "^[.][a-z_]+[.]json$" },
          "artifact_root": { "type": "string", "minLength": 1 },
          "package_root": { "type": "string", "pattern": "^/" },
          "assets": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["artifact_path", "artifact_sha256", "package_name", "asset_class", "provenance", "preferred_source_path"],
              "properties": {
                "artifact_path": { "type": "string", "pattern": "^Plugins/.+/Content/.+\\.uasset$" },
                "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "package_name": { "type": "string", "pattern": "^/" },
                "asset_class": { "type": "string", "minLength": 1 },
                "provenance": { "const": "first_party_native_configuration" },
                "preferred_source_path": { "type": "string", "pattern": "^Plugins/.+/Source/.+\\.(cpp|h)$" }
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "authority_kind": { "const": "generated_definition_manifest" } } },
            "then": { "required": ["manifest_schema_ref", "manifest_id", "collections"] }
          },
          {
            "if": { "properties": { "authority_kind": { "const": "generated_recipe_manifest" } } },
            "then": { "required": ["recipe_root", "recipe_suffix", "artifact_root", "package_root"] }
          },
          {
            "if": { "properties": { "authority_kind": { "const": "producer_input" } } },
            "then": {
              "required": ["assets"],
              "properties": {
                "license_id": { "const": "MPL-2.0" },
                "distribution_class": { "const": "rights_cleared_first_party_code_bearing" }
              }
            }
          }
        ]
      }
    }
  }
}
