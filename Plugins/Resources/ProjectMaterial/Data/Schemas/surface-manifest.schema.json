{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alis.project/schemas/project-material-surface-manifest-v3.json",
  "title": "ProjectMaterial Accepted Surface Manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "records"
  ],
  "properties": {
    "$schema": {
      "const": "../../Schemas/surface-manifest.schema.json"
    },
    "schema_version": {
      "const": 3
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipe_path",
        "recipe_sha256",
        "recipe_source_sha256",
        "family",
        "archetype",
        "compiler_version",
        "output_object_path",
        "semantic_identity",
        "package_sha256",
        "compiler_fingerprint",
        "engine_compatibility"
      ],
      "properties": {
        "recipe_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_/.-]+\\.surface\\.json$"
        },
        "recipe_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "recipe_source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "binding_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "family": {
          "const": "surface_substrate"
        },
        "archetype": {
          "enum": [
            "terrain_metric",
            "terrain_detail_metric",
            "object_metric",
            "height_masks_uv",
            "single_layer_water",
            "aggregate_metric",
            "height_masks_metric",
            "terrain_height_masks_metric"
          ]
        },
        "compiler_version": {
          "enum": [
            "5",
            "8",
            "9",
            "10"
          ]
        },
        "pattern_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "pattern_object_path": {
          "type": "string",
          "pattern": "^/ProjectTexture/Patterns/[A-Za-z0-9_/]+\\.[A-Za-z0-9_]+$"
        },
        "pattern_output_contract": {
          "enum": [
            "surface_structure_rgb_v1",
            "soil_structure_normal_masks_v1",
            "aggregate_signals_normal_v1"
          ]
        },
        "pattern_semantic_identity": {
          "$ref": "#/$defs/sha256"
        },
        "pattern_package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dependency_object_path": {
          "type": "string"
        },
        "dependency_package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "terrain_layout_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "output_object_path": {
          "type": "string",
          "pattern": "^/ProjectMaterial/Surfaces/[A-Za-z0-9_/]+\\.[A-Za-z0-9_]+$"
        },
        "semantic_identity": {
          "$ref": "#/$defs/sha256"
        },
        "package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "compiler_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "engine_compatibility": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "native_resources": {
          "type": "object",
          "minProperties": 4,
          "maxProperties": 4,
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          },
          "propertyNames": {
            "pattern": "^/(Engine|Water)/[A-Za-z0-9_/]+\\.[A-Za-z0-9_]+$"
          }
        }
      },
      "dependentRequired": {
        "dependency_object_path": [
          "dependency_package_sha256"
        ],
        "dependency_package_sha256": [
          "dependency_object_path"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "archetype": {
                "const": "single_layer_water"
              }
            }
          },
          "then": {
            "required": [
              "native_resources"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "pattern_id"
                  ]
                },
                {
                  "required": [
                    "pattern_object_path"
                  ]
                },
                {
                  "required": [
                    "pattern_output_contract"
                  ]
                },
                {
                  "required": [
                    "pattern_semantic_identity"
                  ]
                },
                {
                  "required": [
                    "pattern_package_sha256"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "pattern_id",
              "pattern_object_path",
              "pattern_output_contract",
              "pattern_semantic_identity",
              "pattern_package_sha256"
            ],
            "not": {
              "required": [
                "native_resources"
              ]
            }
          }
        }
      ]
    }
  }
}
