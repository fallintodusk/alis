{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Public Generated Experience Authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "manifest_id", "release_contract_sha256",
    "owner", "assets"
  ],
  "properties": {
    "$schema": { "const": "../Schemas/public_generated_experience_manifest.schema.json" },
    "schema_version": { "const": 1 },
    "manifest_id": { "const": "project_experience_data_public_generated_experiences_v1" },
    "release_contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "owner": { "const": "ProjectExperienceData" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_class", "package_name", "artifact_path", "artifact_sha256",
          "source_path", "source_sha256", "source_json_hash_md5", "schema_path"
        ],
        "properties": {
          "asset_class": { "const": "ProjectExperienceDefinition" },
          "package_name": { "type": "string", "pattern": "^/ProjectExperienceData/Experiences/" },
          "artifact_path": { "type": "string", "pattern": "\\.uasset$" },
          "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "source_path": { "type": "string", "pattern": "\\.json$" },
          "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "source_json_hash_md5": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
          "schema_path": { "const": "Plugins/Resources/ProjectExperienceData/Data/Schemas/experience.schema.json" }
        }
      }
    }
  }
}
