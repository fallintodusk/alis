{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alis.project/schemas/project-texture-pattern-manifest-v3.json",
  "title": "ProjectTexture Accepted Pattern Manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "records"],
  "properties": {
    "$schema": { "const": "../../Schemas/pattern-manifest.schema.json" },
    "schema_version": { "const": 3 },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipe_path",
        "recipe_sha256",
        "recipe_source_sha256",
        "pattern_id",
        "family",
        "algorithm",
        "compiler_version",
        "output_contract",
        "output_object_path",
        "semantic_identity",
        "package_sha256",
        "compiler_fingerprint",
        "engine_compatibility"
      ],
      "properties": {
        "recipe_path": { "type": "string", "pattern": "^[A-Za-z0-9_/.-]+\\.pattern\\.json$" },
        "recipe_sha256": { "$ref": "#/$defs/sha256" },
        "recipe_source_sha256": { "$ref": "#/$defs/sha256" },
        "pattern_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
        "family": { "const": "surface_structure" },
        "algorithm": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
        "compiler_version": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "output_contract": { "const": "surface_structure_rgb_v1" },
        "output_object_path": {
          "type": "string",
          "pattern": "^/ProjectTexture/Patterns/[A-Za-z0-9_/]+\\.[A-Za-z0-9_]+$"
        },
        "semantic_identity": { "$ref": "#/$defs/sha256" },
        "package_sha256": { "$ref": "#/$defs/sha256" },
        "compiler_fingerprint": { "$ref": "#/$defs/sha256" },
        "engine_compatibility": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
      }
    }
  }
}
