{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alis.dev/schemas/mesh-terrain-layout-receipt.schema.json",
  "title": "Project World Mesh Terrain Layout Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "receipt_id",
    "canonical_surface_contract_id",
    "canonical_surface_contract_version",
    "canonical_surface_contract_sha256",
    "adapter_id",
    "adapter_version",
    "adapter_compiler_sha256",
    "engine_identity",
    "layout_id",
    "layout_version",
    "layout_sha256",
    "channels",
    "source_encoding",
    "compiled_encoding",
    "channel_texel_size_cm",
    "channel_texture_max_dimension",
    "uv_set",
    "shared_definition_object_path",
    "shared_definition_package_sha256",
    "build_policy_sha256",
    "receipt_payload",
    "receipt_sha256"
  ],
  "properties": {
    "$schema": { "const": "../../Data/Schemas/mesh-terrain-layout-receipt.schema.json" },
    "schema_version": { "const": 1 },
    "receipt_id": { "const": "project_mesh_terrain_layout" },
    "canonical_surface_contract_id": { "type": "string", "minLength": 1 },
    "canonical_surface_contract_version": { "type": "integer", "minimum": 1 },
    "canonical_surface_contract_sha256": { "$ref": "#/$defs/sha256" },
    "adapter_id": { "const": "project_mesh_terrain" },
    "adapter_version": { "const": 1 },
    "adapter_compiler_sha256": { "$ref": "#/$defs/sha256" },
    "engine_identity": { "type": "string", "minLength": 1 },
    "layout_id": { "const": "project_mesh_terrain_channels" },
    "layout_version": { "const": 1 },
    "layout_sha256": { "$ref": "#/$defs/sha256" },
    "channels": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["semantic_name", "private_channel_index"],
          "properties": {
            "semantic_name": { "const": "ground" },
            "private_channel_index": { "const": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["semantic_name", "private_channel_index"],
          "properties": {
            "semantic_name": { "const": "hydro_transition" },
            "private_channel_index": { "const": 1 }
          }
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "source_encoding": { "const": "float32_vertex_weight" },
    "compiled_encoding": { "const": "unorm8_texture2d_array" },
    "channel_texel_size_cm": { "const": 3000 },
    "channel_texture_max_dimension": { "const": 4096 },
    "uv_set": { "const": 0 },
    "shared_definition_object_path": {
      "const": "/ProjectWorldMeshTerrain/Terrain/MPD_ProjectTerrain_Shared_v1.MPD_ProjectTerrain_Shared_v1"
    },
    "shared_definition_package_sha256": { "$ref": "#/$defs/sha256" },
    "build_policy_sha256": { "$ref": "#/$defs/sha256" },
    "receipt_payload": { "type": "string", "minLength": 1 },
    "receipt_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
