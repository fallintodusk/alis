{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alis.world/schemas/project-world/runtime-profile-v3.json",
  "title": "ProjectWorld Runtime Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "profile_id",
    "profile_kind",
    "grid_id",
    "runtime_partition",
    "gameplay_route",
    "optimization_policy",
    "budgets"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "^(?:\\.\\./)+(?:ProjectWorld/Data/)?Schemas/project_world_runtime_profile\\.schema\\.json$"
    },
    "schema_version": { "const": 3 },
    "profile_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "profile_kind": {
      "enum": ["bounded_procedural_route", "territory_product"]
    },
    "grid_id": { "type": "string", "pattern": "^grid_[a-z0-9]+$" },
    "runtime_partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partition_class",
        "cell_size_m",
        "loading_range_m",
        "block_on_slow_streaming"
      ],
      "properties": {
        "partition_class": { "const": "lhgrid_2d" },
        "cell_size_m": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "loading_range_m": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "block_on_slow_streaming": { "type": "boolean" }
      }
    },
    "gameplay_route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "feature_id",
        "endpoint_inset_m",
        "surface_offset_m",
        "navigation_padding_m",
        "navigation_height_m"
      ],
      "properties": {
        "route_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "feature_id": { "type": "string", "minLength": 1 },
        "endpoint_inset_m": { "type": "number", "minimum": 0, "maximum": 100 },
        "surface_offset_m": { "type": "number", "minimum": 0, "maximum": 10 },
        "navigation_padding_m": { "type": "number", "minimum": 1, "maximum": 1000 },
        "navigation_height_m": { "type": "number", "minimum": 2, "maximum": 1000 }
      }
    },
    "product_spawn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor", "height_above_terrain_m", "yaw_degrees", "pitch_degrees"],
      "properties": {
        "anchor": { "const": "engine_georeference_origin" },
        "height_above_terrain_m": { "type": "number", "minimum": 50, "maximum": 1000 },
        "yaw_degrees": { "type": "number", "minimum": -180, "maximum": 180 },
        "pitch_degrees": { "type": "number", "minimum": -89, "maximum": 0 }
      }
    },
    "optimization_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nanite", "instancing", "hlod"],
      "properties": {
        "nanite": {
          "enum": ["not_applicable_procedural_mesh", "enabled_for_supported_generated_static_meshes"]
        },
        "instancing": {
          "enum": ["not_applicable_unique_geometry", "cell_owned_hism"]
        },
        "hlod": {
          "enum": ["disabled_for_bounded_route", "disabled_for_territory"]
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_source_bytes",
        "procedural_mesh_buffer_bytes",
        "generated_actor_count",
        "mesh_section_draw_call_upper_bound",
        "regeneration_seconds",
        "p95_frame_time_ms"
      ],
      "properties": {
        "generated_source_bytes": { "type": "integer", "minimum": 1 },
        "procedural_mesh_buffer_bytes": { "type": "integer", "minimum": 1 },
        "generated_actor_count": { "type": "integer", "minimum": 1 },
        "mesh_section_draw_call_upper_bound": { "type": "integer", "minimum": 1 },
        "regeneration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "p95_frame_time_ms": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "profile_kind": { "const": "territory_product" } },
        "required": ["profile_kind"]
      },
      "then": { "required": ["product_spawn"] },
      "else": { "not": { "required": ["product_spawn"] } }
    }
  ]
}
