{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alis.world/schemas/project-world/realization-profile-v1.json",
  "title": "ProjectWorld Realization Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "profile_id",
    "world_data_plugin",
    "canonical_profile_id",
    "map_package",
    "runtime_profile_id",
    "protected_authored_roots",
    "excluded_runtime_state_roots",
    "layers"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "project_world_realization_profile\\.schema\\.json$"
    },
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "$ref": "#/$defs/id"
    },
    "world_data_plugin": {
      "type": "string",
      "pattern": "^Project[A-Za-z0-9]+$"
    },
    "canonical_profile_id": {
      "$ref": "#/$defs/id"
    },
    "map_package": {
      "type": "string",
      "pattern": "^/Project[A-Za-z0-9]+/Generated/[A-Za-z0-9_/]+$"
    },
    "runtime_profile_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "const": "none"
        }
      ]
    },
    "protected_authored_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/Project[A-Za-z0-9]+/Authored/[A-Za-z0-9_/]*$"
      }
    },
    "excluded_runtime_state_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/Project[A-Za-z0-9]+/Runtime/[A-Za-z0-9_/]*$"
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/layer"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer_id",
        "layer_kind",
        "generator_id",
        "generator_version",
        "depends_on",
        "canonical_selectors",
        "artifact_root",
        "spatial_ownership",
        "dirty_granularity",
        "dependency_halo_cells",
        "runtime_mapping",
        "settings"
      ],
      "properties": {
        "layer_id": {
          "$ref": "#/$defs/id"
        },
        "layer_kind": {
          "enum": [
            "generated_geography",
            "generated_gameplay_placement",
            "protected_authored_overlay",
            "runtime_state_exclusion"
          ]
        },
        "generator_id": {
          "$ref": "#/$defs/id"
        },
        "generator_version": {
          "type": "integer",
          "minimum": 1
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "canonical_selectors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "artifact_root": {
          "type": "string",
          "pattern": "^/Project[A-Za-z0-9]+/(Generated|Authored|Runtime)/[A-Za-z0-9_/]+$"
        },
        "spatial_ownership": {
          "enum": [
            "compiled_sections_from_canonical_cells",
            "cell_local",
            "object_local",
            "protected_root",
            "excluded_root"
          ]
        },
        "dirty_granularity": {
          "enum": [
            "whole_layer",
            "canonical_cell",
            "source_tile",
            "object_id",
            "never"
          ]
        },
        "dependency_halo_cells": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "runtime_mapping": {
          "enum": [
            "world_partition_spatial",
            "protected",
            "excluded"
          ]
        },
        "settings": {
          "type": "object"
        }
      }
    }
  }
}
