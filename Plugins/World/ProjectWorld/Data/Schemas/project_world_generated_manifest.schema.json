{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alis.world/schemas/project-world/generated-manifest-v1.json",
  "title": "ProjectWorld Generated-Artifact Manifest",
  "description": "Immutable per-scope ownership record for generated content. Authoritative only when referenced by the active-manifest-set record. Contract: docs/territory_generation.md (Layered regeneration contract).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "scope_id",
    "generation",
    "owning_layer",
    "accepted_operation_id",
    "generator_fingerprint",
    "input_identity",
    "artifacts",
    "consumer_references"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "^(?:\\.\\./\\.\\./Schemas|\\.\\./\\.\\./\\.\\./\\.\\./ProjectWorld/Data/Schemas|\\.\\./\\.\\./\\.\\./\\.\\./\\.\\./Plugins/World/ProjectWorld/Data/Schemas)/project_world_generated_manifest\\.schema\\.json$"
    },
    "schema_version": {
      "const": 1
    },
    "scope_id": {
      "type": "string",
      "pattern": "^(map|presentation|layer)_[a-z0-9_]+$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "owning_layer": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "accepted_operation_id": {
      "type": "string",
      "minLength": 1
    },
    "accepted_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "generator_fingerprint": {
      "description": "Deterministic hash of the generator sources, schemas, and lifecycle scripts that produced this manifest.",
      "$ref": "#/$defs/sha256"
    },
    "input_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compile_result_sha256", "presentation_profile_sha256", "runtime_profile_sha256", "map_package"],
      "properties": {
        "compile_result_sha256": {"$ref": "#/$defs/sha256_or_none"},
        "presentation_profile_sha256": {"$ref": "#/$defs/sha256_or_none"},
        "runtime_profile_sha256": {"$ref": "#/$defs/sha256_or_none"},
        "authored_overlay_profile_sha256": {"$ref": "#/$defs/sha256_or_none"},
        "map_package": {"type": "string", "minLength": 1}
      }
    },
    "layer_contract": {
      "$ref": "#/$defs/layer_contract"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "digest_kind", "digest"],
        "properties": {
          "path": {
            "description": "Normalized repository-relative path with forward slashes.",
            "type": "string",
            "pattern": "^[A-Za-z0-9_./ -]+$"
          },
          "kind": {
            "enum": ["map", "external_actor", "external_object", "asset", "built_data", "hlod", "other"]
          },
          "digest_kind": {
            "const": "sha256"
          },
          "digest": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "consumer_references": {
      "description": "Scope IDs that consume artifacts owned by this scope. Consumption never grants mutation rights.",
      "type": "array",
      "items": {"type": "string", "pattern": "^(map|presentation|layer)_[a-z0-9_]+$"},
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"scope_id": {"pattern": "^layer_"}},
        "required": ["scope_id"]
      },
      "then": {"required": ["layer_contract"]},
      "else": {"not": {"required": ["layer_contract"]}}
    }
  ],
  "$defs": {
    "layer_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "realization_profile_id",
        "realization_profile_sha256",
        "normalized_layer_contract_sha256",
        "generator_id",
        "generator_version",
        "artifact_root",
        "canonical_inputs",
        "dependency_inputs",
        "final_dirty_units",
        "semantic_outputs"
      ],
      "properties": {
        "realization_profile_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "realization_profile_sha256": {"$ref": "#/$defs/sha256"},
        "normalized_layer_contract_sha256": {"$ref": "#/$defs/sha256"},
        "generator_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "generator_version": {"type": "integer", "minimum": 1},
        "artifact_root": {"type": "string", "pattern": "^/Project[A-Za-z0-9]+/Generated/[A-Za-z0-9_/]+/$"},
        "canonical_inputs": {
          "type": "array",
          "items": {"$ref": "#/$defs/layer_input"}
        },
        "dependency_inputs": {
          "type": "array",
          "items": {"$ref": "#/$defs/layer_input"}
        },
        "final_dirty_units": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "semantic_outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact_path", "semantic_sha256"],
            "properties": {
              "artifact_path": {"type": "string", "pattern": "^[A-Za-z0-9_./ -]+$"},
              "semantic_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "layer_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "sha256"],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sha256_or_none": {
      "anyOf": [
        {"$ref": "#/$defs/sha256"},
        {"const": "none"}
      ]
    }
  }
}
