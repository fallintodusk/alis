{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alis.world/schemas/project-world/layer-dirty-input-v2.json",
  "title": "ProjectWorld Layer Dirty Operation Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "realization_profile_id", "producer_fingerprints", "base_layers", "identity_dirty_layers", "operator_additions"],
  "properties": {
    "$schema": {"type": "string", "pattern": "project_world_layer_dirty_input\\.schema\\.json$"},
    "schema_version": {"const": 2},
    "realization_profile_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "producer_fingerprints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer_id", "generator_fingerprint"],
        "properties": {
          "layer_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "generator_fingerprint": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "base_layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer_id", "normalized_layer_contract_sha256", "canonical_inputs"],
        "properties": {
          "layer_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "normalized_layer_contract_sha256": {"$ref": "#/$defs/sha256"},
          "canonical_inputs": {
            "type": "array",
            "items": {"$ref": "#/$defs/input"}
          }
        }
      }
    },
    "identity_dirty_layers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
    },
    "operator_additions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer_id", "units"],
        "properties": {
          "layer_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "units": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "sha256"],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
