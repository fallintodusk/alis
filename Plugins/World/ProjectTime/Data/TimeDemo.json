        "position": {
          "x": -260,
          "y": 240
        },
        "size": {
          "x": 384,
          "y": 40
        },
        "text": "Reset to PC time",
        "variant": "Primary",
        "font": "Button"
      },
      {
        "type": "Button",
        "name": "CloseButton",
        "anchor": "TopRight",
        "alignment": {
          "x": 1,
          "y": 0
        },
        "position": {
          "x": -44,
          "y": 240
        },
        "size": {
          "x": 200,
          "y": 40
        },
        "text": "Close (Esc)",
        "variant": "Secondary",
        "font": "Button"
      }
    ]
