{
  "$schema": "../../../UI/ProjectUI/Data/Schemas/ui_layout.schema.json",
  "root": {
    "type": "CanvasPanel",
    "name": "TimeDemoRoot",
    "children": [
      {
        "type": "Border",
        "name": "Panel",
        "anchor": "TopRight",
        "alignment": {
          "x": 1,
          "y": 0
        },
        "position": {
          "x": -24,
          "y": 24
        },
        "size": {
          "x": 640,
          "y": 280
        },
        "background": "Surface",
        "opacity": 0.96
      },
      {
        "type": "TextBlock",
        "name": "TimeLabel",
        "anchor": "TopRight",
        "alignment": {
          "x": 1,
          "y": 0
        },
        "position": {
          "x": -44,
          "y": 44
        },
        "size": {
          "x": 600,
          "y": 40
        },
        "text": "Geographic time",
        "font": "BodyMedium",
        "color": "Text",
        "font_size": 16
      },
      {
        "type": "TextBlock",
        "name": "OffsetLabel",
        "anchor": "TopRight",
        "alignment": {
          "x": 1,
          "y": 0
        },
        "position": {
          "x": -44,
          "y": 90
        },
        "size": {
          "x": 600,
          "y": 28
        },
        "text": "Preview time (-12 to +12 hours)",
        "font": "BodyMedium",
        "color": "Text",
        "font_size": 16
      },
      {
        "type": "Slider",
        "name": "OffsetSlider",
        "anchor": "TopRight",
        "alignment": {
          "x": 1,
          "y": 0
        },
        "position": {
          "x": -44,
          "y": 122
        },
        "size": {
          "x": 600,
          "y": 24
        },
        "min": -12,
        "max": 12,
        "value": 0,
        "stepSize": 0.1
      },
      {
        "type": "TextBlock",
        "name": "SpeedLabel",
        "anchor": "TopRight",
        "alignment": {
          "x": 1,
          "y": 0
        },
        "position": {
          "x": -44,
          "y": 158
        },
        "size": {
          "x": 600,
          "y": 28
        },
        "text": "Speed (0 pauses the calendar, up to 60x)",
        "font": "BodyMedium",
        "color": "Text",
        "font_size": 16
      },
      {
        "type": "Slider",
        "name": "RateSlider",
        "anchor": "TopRight",
        "alignment": {
          "x": 1,
          "y": 0
        },
        "position": {
          "x": -44,
          "y": 190
        },
        "size": {
          "x": 600,
          "y": 24
        },
        "min": 0,
        "max": 60,
        "value": 1,
        "stepSize": 1
      },
      {
        "type": "Button",
        "name": "ResetButton",
        "anchor": "TopRight",
        "alignment": {
          "x": 1,
          "y": 0
