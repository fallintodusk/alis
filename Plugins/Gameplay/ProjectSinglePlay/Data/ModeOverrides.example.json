{
  "$schema": "Schemas/single_play_mode_overrides.schema.json",
  "modes": [
    {
      "modeName": "Single",
      "featureConfigs": {
        "Difficulty": "{\"level\":\"normal\",\"damageMultiplier\":1.0}"
      }
    },
    {
      "modeName": "Survival",
      "playerControllerClass": "/Script/ProjectSinglePlayClient.SinglePlayController",
      "requiredFeaturePlugins": [
        "ProjectCombat",
        "ProjectInventory"
      ],
      "featureNames": [
        "Combat",
        "Inventory",
        "Hunger",
        "Thirst"
      ],
      "featureConfigs": {
        "Difficulty": "{\"level\":\"hard\",\"damageMultiplier\":1.5}",
        "Hunger": "{\"enabled\":true,\"drainRate\":0.1}",
        "Thirst": "{\"enabled\":true,\"drainRate\":0.15}",
        "Permadeath": "{\"enabled\":false}"
      }
    },
    {
      "modeName": "Hardcore",
      "featureConfigs": {
        "Combat": "{\"friendlyFire\":true}",
        "SaveSystem": "{\"autoSave\":false,\"manualSaveOnly\":true,\"singleSlot\":true}"
      }
    }
  ]
}
